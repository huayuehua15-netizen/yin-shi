# ---------------------------------------------------------------------------
# Cadence — environment configuration
# Everything here is optional: the app boots in Zero-Key Local mode by default.
# Copy to .env and fill in only the provider you actually use. Never commit .env.
# ---------------------------------------------------------------------------

# --- Option A: Google Gemini -------------------------------------------------
# Enables server-side audio transcription and LLM coaching.
# GEMINI_API_KEY=

# --- Option B: OpenAI-compatible LLM / local Ollama --------------------------
# Leave GEMINI_API_KEY unset to use this path. Point at Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
#   OPENAI_API_KEY=ollama
# LLM_BASE_URL=
# LLM_MODEL=
# OPENAI_API_KEY=

# --- Option C: OpenAI-compatible Whisper transcription -----------------------
# Optional; without it, uploads still work when a transcript is pasted alongside
# the audio, or when browser speech-to-text is used.
# WHISPER_BASE_URL=
# WHISPER_MODEL=whisper-1

# --- Provider selection ------------------------------------------------------
# auto (default) | local | gemini | openai-compatible
# CADENCE_PROVIDER=auto

# --- Runtime -----------------------------------------------------------------
# HTTP port for the Express + Vite server.
PORT=3000

# Directory for calls.json and uploaded audio. Mount a writable volume in Docker.
CADENCE_DATA_DIR=./data

# Set automatically by the production start script; do not set manually.
# NODE_ENV=production
