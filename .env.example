# ---------------------------------------------------------------------------
# AI Provider Configuration (Optional — works in Zero-Key Local Mode by default)
# ---------------------------------------------------------------------------
# Option A: Google Gemini (free tier available via Google AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Option B: Free Local Ollama or any OpenAI-compatible API (leave GEMINI_API_KEY unset)
# Example for local Ollama: LLM_BASE_URL="http://localhost:11434/v1" LLM_MODEL="qwen2.5:7b"
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL="llama3.1"
# OPENAI_API_KEY="ollama"
# WHISPER_BASE_URL="http://localhost:8000/v1"
# WHISPER_MODEL="whisper-1"

# APP_URL: Hosted URL (automatically injected by Cloud Run / AI Studio)
APP_URL="MY_APP_URL"

# PORT: HTTP port for the Express + Vite server (default: 3000)
PORT=3000

# CADENCE_DATA_DIR: Directory for persisted call history and uploaded audio files (default: ./data)
CADENCE_DATA_DIR="./data"
